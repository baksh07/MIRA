# Copy to frontend/.env.local (git-ignored) and fill in.
# Only browser-safe values belong here: NEXT_PUBLIC_* is shipped to every visitor.

NEXT_PUBLIC_SUPABASE_URL=
# The publishable (anon) key, safe for the browser when Row Level Security is on
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Where the FastAPI backend runs
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
