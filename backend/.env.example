# Copy to backend/.env (git-ignored) and fill in. Never commit real values.

# LLM for the LangGraph agent: Groq primary, OpenAI as fallback when Groq fails
OPENAI_API_KEY=
# OpenAI model used only when every Groq model fails (tool calling verified 2026-11-13)
OPENAI_MODELS=gpt-4.1-mini,gpt-5-mini
GROQ_API_KEY=
# Groq models, tried in order; each has its own free quota (1000 req/day, 8000 tokens/min on the free tier).
# On a rate limit (429) or error the next one takes over; OpenAI is the last fallback.
# (llama-3.1-8b-instant is retired on Groq; all three below passed a tool-calling test 2026-11-13.)
GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b

# Voice: Deepgram for speech-to-text and text-to-speech
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Optional: ELEVENLABS_VOICE_ID (default Jessica), ELEVENLABS_MODEL (default eleven_flash_v2_5), TTS_PROVIDER=deepgram to switch back

# Supabase cloud (server side only: the secret key bypasses Row Level Security)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Postgres connection string: Supabase > Connect > Session pooler (includes the DB password)
DATABASE_URL=

# Deployment (used by Claude from this machine only; not needed by the running app)
# Vercel: vercel.com/account/tokens  |  Render: dashboard.render.com > Account Settings > API Keys
VERCEL_TOKEN=
RENDER_API_KEY=
